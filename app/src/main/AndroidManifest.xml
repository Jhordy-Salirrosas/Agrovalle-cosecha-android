<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permiso para feedback háptico -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AgroValleCosecha">

        <!-- 1. Pantalla de Inicio de Sesión (Launcher) -->
        <activity
            android:name=".view.LoginActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Menú Principal -->
        <activity
            android:name=".view.MenuActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 3. Registro de Asistencia QR -->
        <activity
            android:name=".view.AsistenciaQRActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 4. Búsqueda por DNI -->
        <activity
            android:name=".view.BusquedaDNIActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- 5. Contexto Agronómico del Turno -->
        <activity
            android:name=".view.ContextoAgronomicoActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 6. Calibración de Tara -->
        <activity
            android:name=".view.CalibrarTaraActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 7. Registro de Pesaje en Campo -->
        <activity
            android:name=".view.RegistrarPesajeActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- 8. Confirmación de Pesaje -->
        <activity
            android:name=".view.ConfirmacionActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

    </application>

</manifest>
