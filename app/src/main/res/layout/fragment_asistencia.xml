<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor"
    android:orientation="vertical">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarAsistencia"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primaryColor"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="📝 Registro de Asistencia"
        app:titleTextColor="@color/colorOnPrimary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Sección de búsqueda -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Identificar Jornalero"
                        android:textColor="@color/primaryDarkColor"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- Campo DNI -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDni"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="Buscar por DNI (8 dígitos)"
                        app:endIconMode="clear_text"
                        app:startIconDrawable="@android:drawable/ic_menu_search">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDni"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="8"
                            android:textSize="20sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Botón Escanear QR -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEscanearQr"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="12dp"
                        android:text="📷 Escanear Fotocheck QR"
                        android:textSize="16sp"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card resultado jornalero -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardResultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="#E8F5E9"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/primaryColor"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvNombreJornalero"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nombre del Jornalero"
                        android:textColor="@color/primaryDarkColor"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvDniJornalero"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="DNI: 00000000"
                        android:textColor="@color/colorOnBackground"
                        android:textSize="16sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvCuadrillaJornalero"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Cuadrilla: CUAD-01"
                        android:textColor="#555555"
                        android:textSize="14sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipEstadoAsistencia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="PUNTUAL"
                        android:textColor="@android:color/white"
                        app:chipBackgroundColor="@color/primaryColor" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card error / ya registrado -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMensaje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvMensaje"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:textColor="@color/colorOnBackground"
                    android:textSize="16sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Botón Registrar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegistrarAsistencia"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="20dp"
                android:enabled="false"
                android:text="✅  REGISTRAR ASISTENCIA"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@color/primaryColor"
                app:cornerRadius="16dp" />

            <!-- Contador del día -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvContadorDia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Registros hoy: 0 (Puntuales: 0 · Tardanzas: 0)"
                android:textColor="#555555"
                android:textSize="13sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
